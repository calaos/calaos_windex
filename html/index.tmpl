<nav class="menu" aria-label="{{ .T.NavMain }}">
{{- range .T.Menu -}}
{{- if .Button }}<a class="btn btn-p" href="{{ .URL }}">{{ .Name }}</a>
{{- else if .Icon }}<a class="menu-gh" href="{{ .URL }}" aria-label="{{ $.T.NavGithub }}"><svg class="ic" aria-hidden="true"><use href="#i-github"/></svg></a>
{{- else }}<a href="{{ .URL }}">{{ .Name }}</a>
{{- end -}}
{{- end -}}
</nav>
<button class="burger" aria-expanded="false" aria-controls="drawer" aria-label="{{ .T.NavBurger }}"><svg class="ic" aria-hidden="true"><use href="#i-menu"/></svg></button>
</div><nav class="drawer" id="drawer" aria-label="{{ .T.NavMobile }}">
{{- range .T.Menu -}}
{{- if .Button }}<a class="btn btn-p" href="{{ .URL }}">{{ .Name }}</a>
{{- else if .Icon }}<a href="{{ .URL }}"><svg class="ic" aria-hidden="true"><use href="#i-github"/></svg>{{ .Name }}</a>
{{- else }}<a href="{{ .URL }}">{{ .Name }}</a>
{{- end -}}
{{- end -}}
</nav></header>
{{- end -}}

{{- define "foot" -}}
<footer><div class="wrap"><span class="lbl">{{ .T.Language }}</span><div class="lang"><a href="https://calaos.fr/fr/" hreflang="fr" lang="fr"{{ if eq .T.Lang "fr" }} aria-current="true"{{ end }}>FR</a><a href="https://calaos.fr/en/" hreflang="en" lang="en"{{ if eq .T.Lang "en" }} aria-current="true"{{ end }}>EN</a></div></div></footer>
<script {{ if .Prefix }}src="/{{ .Prefix }}/static/menu.js"{{ else }}src="/static/menu.js"{{ end }}></script>
{{- end -}}

{{- define "error" -}}
<!DOCTYPE html>
<html lang="{{ .T.Lang }}">
<head>
<title>{{ .Status }} | Calaos {{ .T.Downloads }}</title>
<meta name="robots" content="noindex">
{{ template "head" . }}
</head>
<body>
{{ template "nav" . }}
<main id="main"><div class="wrap err">
<p class="code">{{ .Code }}</p>
<h1>{{ .Status }}</h1>
<p>{{ .Message }}</p>
<a class="btn btn-p" {{ if .Prefix }}href="/{{ .Prefix }}/"{{ else }}href="/"{{ end }}>{{ .T.BackDownloads }}</a>
</div></main>
{{ template "foot" . }}
</body>
</html>
{{- end -}}
<!DOCTYPE html>
<html lang="{{ .T.Lang }}">
<head>
<title>{{ .T.IndexOf }} {{ if .Prefix }}/{{ .Prefix }}{{ end }}{{ .Name }}</title>
{{ template "head" . }}
{{ if .UmamiWebsiteId }}
<script defer src="{{ .UmamiScriptURL }}" data-website-id="{{ .UmamiWebsiteId }}"></script>
{{ end }}
</head>
<body>
{{ template "nav" . }}
<main id="main"><div class="wrap">
<nav aria-label="{{ .T.Breadcrumb }}">
<ol class="crumbs">
{{- range $b := .Breadcrumbs }}
{{- if $b.Current }}
<li><span aria-current="page">{{ $b.Name }}</span></li>
{{- else }}
<li><a href="{{ $b.Path }}">{{ $b.Name }}</a></li>
{{- end }}
{{- end }}
</ol>
</nav>
<span class="eyebrow">{{ .T.Downloads }}</span>
<h1>{{ if .Prefix }}/{{ .Prefix }}{{ end }}{{ .Name }}</h1>
{{ if or .Folders .Files }}
<ul class="list">
<li class="row head" aria-hidden="true"><span></span><span>{{ .T.Name }}</span><span class="date">{{ .T.Modified }}</span><span class="size">{{ .T.Size }}</span></li>
{{- if .ShowParent }}
<li class="row parent"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/icons/folder-home.png"{{ else }}src="/static/icons/folder-home.png"{{ end }} alt=""><a class="name" href="../">{{ .T.ParentDir }}</a></li>
{{- end }}
{{- range .Folders }}
<li class="row dir"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/icons/{{ .Icon }}"{{ else }}src="/static/icons/{{ .Icon }}"{{ end }} alt="{{ $.T.Folder }}"><a class="name" href="./{{ .Name }}/">{{ .Name }}/</a></li>
{{- end }}
{{- range .Files }}
<li class="row"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/icons/{{ .Icon }}"{{ else }}src="/static/icons/{{ .Icon }}"{{ end }} alt="{{ $.T.File }}"><a class="name" href="./{{ .Name }}">{{ .Name }}</a><span class="date">{{ .ModifiedDate }}</span><span class="size">{{ .Size }}</span></li>
{{- end }}
</ul>
{{ end }}
{{ if not (or .Folders .Files) }}
<div class="empty">
<h2>{{ .T.Empty }}</h2>
<p>{{ .T.EmptyHint }}</p>
{{ if .ShowParent }}<a class="btn btn-p" href="../">{{ .T.BackToParent }}</a>{{ end }}
</div>
{{ end }}
</div></main>
{{ template "foot" . }}
</body>
</html>
