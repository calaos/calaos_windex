{{- define "head" -}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" {{ if .Prefix }}href="/{{ .Prefix }}/static/favicon.png"{{ else }}href="/static/favicon.png"{{ end }} type="image/png">
<link rel="preload" {{ if .Prefix }}href="/{{ .Prefix }}/static/fonts/manrope/manrope-latin.woff2"{{ else }}href="/static/fonts/manrope/manrope-latin.woff2"{{ end }} as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" {{ if .Prefix }}href="/{{ .Prefix }}/static/style.css"{{ else }}href="/static/style.css"{{ end }}>
{{- end -}}

{{- define "nav" -}}
<header class="nav"><div class="wrap">
<a class="logo" href="https://calaos.fr/" aria-label="Calaos"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/logo.svg"{{ else }}src="/static/logo.svg"{{ end }} alt="Calaos" width="112" height="18"></a>
<a class="link" href="https://calaos.fr/">calaos.fr</a>
<a class="link" href="https://doc.calaos.fr/en/">Documentation</a>
</div></header>
{{- end -}}

{{- define "error" -}}
<!DOCTYPE html>
<html lang="en">
<head>
<title>{{ .Status }} | Calaos downloads</title>
<meta name="robots" content="noindex">
{{ template "head" . }}
</head>
<body>
{{ template "nav" . }}
<main><div class="wrap err">
<p class="code">{{ .Code }}</p>
<h1>{{ .Status }}</h1>
<p>{{ .Message }}</p>
<a class="btn" {{ if .Prefix }}href="/{{ .Prefix }}/"{{ else }}href="/"{{ end }}>Back to downloads</a>
</div></main>
</body>
</html>
{{- end -}}
<!DOCTYPE html>
<html lang="en">
<head>
<title>Index of {{ if .Prefix }}/{{ .Prefix }}{{ end }}{{ .Name }}</title>
{{ template "head" . }}
{{ if .UmamiWebsiteId }}
<script defer src="{{ .UmamiScriptURL }}" data-website-id="{{ .UmamiWebsiteId }}"></script>
{{ end }}
</head>
<body>
{{ template "nav" . }}
<main><div class="wrap">
<nav aria-label="Breadcrumb">
<ol class="crumbs">
{{- range $b := .Breadcrumbs }}
{{- if $b.Current }}
<li><span aria-current="page">{{ $b.Name }}</span></li>
{{- else }}
<li><a href="{{ $b.Path }}">{{ $b.Name }}</a></li>
{{- end }}
{{- end }}
</ol>
</nav>
<span class="eyebrow">Downloads</span>
<h1>{{ if .Prefix }}/{{ .Prefix }}{{ end }}{{ .Name }}</h1>
{{ if or .Folders .Files }}
<ul class="list">
<li class="row head" aria-hidden="true"><span></span><span>Name</span><span class="date">Last modified</span><span class="size">Size</span></li>
{{- if .ShowParent }}
<li class="row parent"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/icons/folder-home.png"{{ else }}src="/static/icons/folder-home.png"{{ end }} alt=""><a class="name" href="../">Parent directory</a></li>
{{- end }}
{{- range .Folders }}
<li class="row dir"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/icons/{{ .Icon }}"{{ else }}src="/static/icons/{{ .Icon }}"{{ end }} alt="Folder"><a class="name" href="./{{ .Name }}/">{{ .Name }}/</a></li>
{{- end }}
{{- range .Files }}
<li class="row"><img {{ if .Prefix }}src="/{{ .Prefix }}/static/icons/{{ .Icon }}"{{ else }}src="/static/icons/{{ .Icon }}"{{ end }} alt="File"><a class="name" href="./{{ .Name }}">{{ .Name }}</a><span class="date">{{ .ModifiedDate }}</span><span class="size">{{ .Size }}</span></li>
{{- end }}
</ul>
{{ end }}
{{ if not (or .Folders .Files) }}
<div class="empty">
<h2>This folder is empty</h2>
<p>There is nothing to download here yet.</p>
{{ if .ShowParent }}<a class="btn" href="../">Back to parent folder</a>{{ end }}
</div>
{{ end }}
</div></main>
</body>
</html>
